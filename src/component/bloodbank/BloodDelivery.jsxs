import React, { useState } from 'react';
import { base44 } from '@/api/base44Client';
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import { Truck, MapPin, Clock, CheckCircle, User, Timer, Navigation, AlertTriangle, Shield } from "lucide-react";
import BloodGroupBadge from "@/components/shared/BloodGroupBadge";
import UrgencyBadge from "@/components/shared/UrgencyBadge";
import StatusBadge from "@/components/shared/StatusBadge";
import { calculateETA } from "@/components/shared/aiSimulation";
import moment from 'moment';

const AGENTS = [
  { id: 'A001', name: 'Ravi Kumar', vehicle: 'Ambulance', available: true },
  { id: 'A002', name: 'Priya Singh', vehicle: 'Motorcycle', available: true },
  { id: 'A003', name: 'Deepak Mehta', vehicle: 'Ambulance', available: false },
  { id: 'A004', name: 'Sneha Reddy', vehicle: 'Car', available: true },
];

const ROUTE_SIMULATION = [
  { label: 'Optimal Route A', distance: 4.2, time: 12, via: 'NH-48' },
  { label: 'Alternate Route B', distance: 6.5, time: 18, via: 'Ring Road' },
  { label: 'Emergency Route C', distance: 3.8, time: 9, via: 'Dedicated Lane' },
];

export default function BloodBankDelivery({ requests, bloodUnits, onSuccess }) {
  const [assignDialog, setAssignDialog] = useState(null);
  const [selectedAgent, setSelectedAgent] = useState('');
  const [loading, setLoading] = useState(null);

  const dispatchableRequests = requests.filter(r => r.status === 'approved');
  const inTransitRequests = requests.filter(r => r.status === 'in_transit');
  const deliveredRequests = requests.filter(r => r.status === 'delivered').slice(0, 10);

  const goldenHourPassed = (request) => {
    const created = new Date(request.created_date);
    const elapsed = (Date.now() - created) / 1000 / 60; // minutes
    return elapsed > 60;
  };

  const getElapsedTime = (request) => {
    const mins = Math.round((Date.now() - new Date(request.created_date)) / 60000);
    return mins;
  };

  const handleDispatch = async (request) => {
    if (!selectedAgent) return;
    setLoading(request.id);

    const agent = AGENTS.find(a => a.id === selectedAgent);
    const reservedUnits = bloodUnits.filter(u => u.blood_group === request.blood_group && u.status === 'reserved').slice(0, request.quantity);
    for (const unit of reservedUnits) {
      await base44.entities.BloodUnit.update(unit.id, { status: 'dispatched' });
    }

    await base44.entities.BloodRequest.update(request.id, {
      status: 'in_transit',
      delivery_agent: agent?.name,
      dispatch_time: new Date().toISOString()
    });

    await base44.entities.AuditLog.create({
      action_type: 'blood_dispatched',
      entity_type: 'BloodRequest',
      entity_id: request.id,
      description: `Dispatched ${request.quantity} units of ${request.blood_group} via ${agent?.name} (${agent?.vehicle})`
    });

    setLoading(null);
    setAssignDialog(null);
    setSelectedAgent('');
    onSuccess?.();
  };

  const handleConfirmDelivery = async (request) => {
    setLoading(request.id);
    const elapsed = getElapsedTime(request);
    const dispatched = bloodUnits.filter(u => u.blood_group === request.blood_group && u.status === 'dispatched').slice(0, request.quantity);
    for (const unit of dispatched) {
      await base44.entities.BloodUnit.update(unit.id, { status: 'used' });
    }
    await base44.entities.BloodRequest.update(request.id, {
      status: 'delivered',
      delivery_time: new Date().toISOString(),
      golden_hour_met: elapsed <= 60
    });
    await base44.entities.AuditLog.create({
      action_type: 'delivery_confirmed',
      entity_type: 'BloodRequest',
      entity_id: request.id,
      description: `Delivery confirmed for ${request.quantity} units of ${request.blood_group}. Golden hour: ${elapsed <= 60 ? 'MET' : 'MISSED'}`
    });
    setLoading(null);
    onSuccess?.();
  };

  const simRoute = ROUTE_SIMULATION[0];

  return (
    <div className="space-y-6">
      {/* Route Simulation Panel */}
      <Card className="bg-gradient-to-r from-slate-900 to-slate-800 border-0">
        <CardContent className="p-6">
          <div className="flex items-center gap-2 mb-4">
            <Navigation className="w-5 h-5 text-blue-400" />
            <h3 className="font-semibold text-white">Ambulance Routing Simulation</h3>
          </div>
          <div className="grid grid-cols-3 gap-4">
            {ROUTE_SIMULATION.map((route, i) => (
              <div key={i} className={`p-4 rounded-xl border ${i === 2 ? 'bg-blue-900/60 border-blue-500' : 'bg-slate-700/50 border-slate-600'}`}>
                <div className="flex items-center justify-between mb-2">
                  <span className={`text-sm font-medium ${i === 2 ? 'text-blue-300' : 'text-slate-300'}`}>{route.label}</span>
                  {i === 2 && <Badge className="bg-blue-500 text-white text-xs">Fastest</Badge>}
                </div>
                <div className="space-y-1">
                  <div className="flex items-center gap-2 text-slate-300 text-sm">
                    <MapPin className="w-3 h-3" /> {route.distance} km
                  </div>
                  <div className="flex items-center gap-2 text-slate-300 text-sm">
                    <Timer className="w-3 h-3" /> {route.time} min ETA
                  </div>
                  <div className="text-xs text-slate-400">Via: {route.via}</div>
                </div>
              </div>
            ))}
          </div>
        </CardContent>
      </Card>

      {/* Ready to Dispatch */}
      <Card className="bg-white border border-slate-100">
        <CardHeader className="pb-2">
          <CardTitle className="text-base font-semibold text-slate-800 flex items-center gap-2">
            <Truck className="w-5 h-5 text-purple-500" />
            Ready to Dispatch ({dispatchableRequests.length})
          </CardTitle>
        </CardHeader>
        <CardContent className="p-0">
          {dispatchableRequests.length === 0 ? (
            <div className="py-12 text-center text-slate-500">
              <Truck className="w-12 h-12 mx-auto mb-3 text-slate-300" />
              <p>No requests ready for dispatch</p>
            </div>
          ) : (
            <Table>
              <TableHeader>
                <TableRow>
                  <TableHead>Request</TableHead>
                  <TableHead>Blood Group</TableHead>
                  <TableHead>Urgency</TableHead>
                  <TableHead>Destination</TableHead>
                  <TableHead>Time Elapsed</TableHead>
                  <TableHead>Golden Hour</TableHead>
                  <TableHead>Action</TableHead>
                </TableRow>
              </TableHeader>
              <TableBody>
                {dispatchableRequests.map(req => {
                  const elapsed = getElapsedTime(req);
                  const goldenMiss = elapsed > 60;
                  return (
                    <TableRow key={req.id} className={goldenMiss ? 'bg-red-50' : ''}>
                      <TableCell className="font-mono text-xs">{req.request_number || req.id.slice(0, 8)}</TableCell>
                      <TableCell><BloodGroupBadge group={req.blood_group} /></TableCell>
                      <TableCell><UrgencyBadge urgency={req.urgency} /></TableCell>
                      <TableCell className="text-sm">{req.delivery_address || req.hospital_name || 'Patient Location'}</TableCell>
                      <TableCell>
                        <Badge className={goldenMiss ? 'bg-red-100 text-red-700' : elapsed > 45 ? 'bg-orange-100 text-orange-700' : 'bg-green-100 text-green-700'}>
                          <Clock className="w-3 h-3 mr-1" />{elapsed} min
                        </Badge>
                      </TableCell>
                      <TableCell>
                        {goldenMiss ? (
                          <Badge className="bg-red-500 text-white"><AlertTriangle className="w-3 h-3 mr-1" />MISSED</Badge>
                        ) : (
                          <Badge className="bg-green-100 text-green-700"><Shield className="w-3 h-3 mr-1" />Active</Badge>
                        )}
                      </TableCell>
                      <TableCell>
                        <Button size="sm" className="bg-purple-500 hover:bg-purple-600" onClick={() => setAssignDialog(req)}>
                          <User className="w-3 h-3 mr-1" /> Assign Agent
                        </Button>
                      </TableCell>
                    </TableRow>
                  );
                })}
              </TableBody>
            </Table>
          )}
        </CardContent>
      </Card>

      {/* In Transit */}
      <Card className="bg-white border border-slate-100">
        <CardHeader className="pb-2">
          <CardTitle className="text-base font-semibold text-slate-800 flex items-center gap-2">
            <Navigation className="w-5 h-5 text-blue-500 animate-pulse" />
            In Transit — Real-Time ETA ({inTransitRequests.length})
          </CardTitle>
        </CardHeader>
        <CardContent>
          {inTransitRequests.length === 0 ? (
            <div className="py-8 text-center text-slate-500">No deliveries in transit</div>
          ) : (
            <div className="space-y-3">
              {inTransitRequests.map(req => {
                const distance = 3 + Math.random() * 8;
                const eta = calculateETA(distance, req.urgency);
                const elapsed = getElapsedTime(req);
                const goldenLeft = Math.max(0, 60 - elapsed);
                return (
                  <div key={req.id} className="p-4 bg-blue-50 border border-blue-200 rounded-xl">
                    <div className="flex items-center justify-between flex-wrap gap-3">
                      <div className="flex items-center gap-3">
                        <div className="w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center">
                          <Truck className="w-4 h-4 text-white" />
                        </div>
                        <div>
                          <div className="flex items-center gap-2">
                            <BloodGroupBadge group={req.blood_group} size="sm" />
                            <span className="text-sm font-medium text-slate-700">{req.quantity} units</span>
                            <UrgencyBadge urgency={req.urgency} />
                          </div>
                          <p className="text-xs text-slate-500 mt-0.5">
                            Agent: {req.delivery_agent || 'Assigned'} • To: {req.hospital_name || 'Patient'}
                          </p>
                        </div>
                      </div>
                      <div className="flex items-center gap-3">
                        <div className="text-center">
                          <p className="text-lg font-bold text-blue-600">{eta} min</p>
                          <p className="text-xs text-slate-500">ETA</p>
                        </div>
                        <div className="text-center">
                          <p className={`text-lg font-bold ${goldenLeft <= 10 ? 'text-red-600' : goldenLeft <= 20 ? 'text-orange-600' : 'text-green-600'}`}>{goldenLeft} min</p>
                          <p className="text-xs text-slate-500">Golden Hr Left</p>
                        </div>
                        <Button size="sm" className="bg-green-500 hover:bg-green-600" onClick={() => handleConfirmDelivery(req)} disabled={loading === req.id}>
                          {loading === req.id ? '...' : <><CheckCircle className="w-3 h-3 mr-1" />Confirm</>}
                        </Button>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          )}
        </CardContent>
      </Card>

      {/* Recent Deliveries */}
      <Card className="bg-white border border-slate-100">
        <CardHeader className="pb-2">
          <CardTitle className="text-base font-semibold text-slate-800 flex items-center gap-2">
            <CheckCircle className="w-5 h-5 text-green-500" />
            Recent Deliveries
          </CardTitle>
        </CardHeader>
        <CardContent>
          {deliveredRequests.length === 0 ? (
            <div className="py-6 text-center text-slate-500 text-sm">No deliveries yet</div>
          ) : (
            <div className="space-y-2">
              {deliveredRequests.map(req => (
                <div key={req.id} className="flex items-center justify-between p-3 bg-slate-50 rounded-lg">
                  <div className="flex items-center gap-2">
                    <BloodGroupBadge group={req.blood_group} size="sm" />
                    <span className="text-sm text-slate-600">{req.quantity} units → {req.hospital_name || 'Patient'}</span>
                  </div>
                  <div className="flex items-center gap-2">
                    {req.golden_hour_met !== false ? (
                      <Badge className="bg-green-100 text-green-700"><Shield className="w-3 h-3 mr-1" />Golden Hr Met</Badge>
                    ) : (
                      <Badge className="bg-red-100 text-red-700"><AlertTriangle className="w-3 h-3 mr-1" />Golden Hr Missed</Badge>
                    )}
                    <span className="text-xs text-slate-500">{moment(req.updated_date || req.created_date).fromNow()}</span>
                  </div>
                </div>
              ))}
            </div>
          )}
        </CardContent>
      </Card>

      {/* Assign Agent Dialog */}
      {assignDialog && (
        <div className="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
          <div className="bg-white rounded-2xl shadow-2xl p-6 w-full max-w-md">
            <h3 className="font-bold text-slate-900 text-lg mb-4 flex items-center gap-2">
              <User className="w-5 h-5 text-purple-500" /> Assign Delivery Agent
            </h3>
            <div className="space-y-3 mb-5">
              {AGENTS.map(agent => (
                <div 
                  key={agent.id}
                  onClick={() => agent.available && setSelectedAgent(agent.id)}
                  className={`p-3 rounded-xl border-2 cursor-pointer transition-all ${
                    selectedAgent === agent.id ? 'border-purple-500 bg-purple-50' :
                    agent.available ? 'border-slate-200 hover:border-slate-300' :
                    'border-slate-100 bg-slate-50 opacity-50 cursor-not-allowed'
                  }`}
                >
                  <div className="flex items-center justify-between">
                    <div>
                      <p className="font-medium text-slate-800">{agent.name}</p>
                      <p className="text-xs text-slate-500">{agent.vehicle}</p>
                    </div>
                    <Badge className={agent.available ? 'bg-green-100 text-green-700' : 'bg-slate-100 text-slate-500'}>
                      {agent.available ? 'Available' : 'Busy'}
                    </Badge>
                  </div>
                </div>
              ))}
            </div>
            <div className="flex gap-3">
              <Button 
                className="flex-1 bg-purple-500 hover:bg-purple-600"
                disabled={!selectedAgent || loading === assignDialog.id}
                onClick={() => handleDispatch(assignDialog)}
              >
                {loading === assignDialog.id ? 'Dispatching...' : <><Truck className="w-4 h-4 mr-2" />Dispatch</>}
              </Button>
              <Button variant="outline" className="flex-1" onClick={() => { setAssignDialog(null); setSelectedAgent(''); }}>
                Cancel
              </Button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}